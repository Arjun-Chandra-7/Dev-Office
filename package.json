{
  "name": "dev-office",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Live developer virtual office for ~/Madara/Dev",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "vite build && NODE_ENV=production tsx server/index.ts",
    "serve": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test server/*.test.ts",
    "check:security": "node scripts/security-check.mjs",
    "bake": "scripts/bake-kit.sh",
    "check:live": "node scripts/live-probe.mjs",
    "build:static": "tsx scripts/export-static.ts && VITE_STATIC=1 vite build"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@react-three/postprocessing": "^3.1.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "camera-controls": "^3.1.2",
    "express": "^5.2.1",
    "node-pty": "^1.1.0",
    "postprocessing": "^6.39.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "tsx": "^4.23.15",
    "ws": "^8.22.0",
    "zustand": "^5.0.15"
  },
  "engines": {
    "node": ">=20"
  }
}
